<UserControl x:Class="UTAU.Views.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:UTAU"
             xmlns:vm="clr-namespace:UTAU.ViewModels"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type={x:Type vm:NoteEditorViewModel}}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccidentalRowBrush" Color="#26000000"/>
        <SolidColorBrush x:Key="AccidentalKeyBrush" Color="#40000000"/>
    </UserControl.Resources>
    <c:PopupButton Content="{x:Static root:Texts.EditNotes}"
                   PopupWidth="960"
                   PopupHeight="460"
                   ResizeMode="Both"
                   BeginEdit="PopupButton_BeginEdit"
                   EndEdit="PopupButton_EndEdit">
        <c:PopupButton.PopupContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="272"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Width="26" Height="26" Command="{Binding ZoomOutCommand}" ToolTip="{x:Static root:Texts.ZoomOut}"
                            Content="{DynamicResource {x:Static icons:IconKeys.MagnifyMinusOutline}}"/>
                    <Button Width="26" Height="26" Command="{Binding ZoomInCommand}" ToolTip="{x:Static root:Texts.ZoomIn}"
                            Content="{DynamicResource {x:Static icons:IconKeys.MagnifyPlusOutline}}"/>
                    <Button Width="26" Height="26" Command="{Binding InsertRestCommand}" ToolTip="{x:Static root:Texts.InsertRest}"
                            Content="{DynamicResource {x:Static icons:IconKeys.Plus}}"/>
                    <Button Width="26" Height="26" Command="{Binding RemoveNoteCommand}" ToolTip="{x:Static root:Texts.RemoveNote}"
                            Content="{DynamicResource {x:Static icons:IconKeys.Delete}}"/>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"
                               Text="{x:Static root:Texts.NoteEditorHint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="KeyboardScroller" Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Keyboard}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="{Binding Height}"
                                            BorderThickness="0,0,1,1"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAccidental}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccidentalKeyBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Margin="0,0,3,0" FontSize="9" Opacity="0.75"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="RollScroller" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="RollScroller_ScrollChanged"
                                  PreviewMouseWheel="RollScroller_PreviewMouseWheel">
                        <Canvas x:Name="RollCanvas"
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                Background="Transparent"
                                MouseMove="RollCanvas_MouseMove"
                                MouseLeftButtonUp="RollCanvas_MouseLeftButtonUp"
                                MouseLeave="RollCanvas_MouseLeave">
                            <ItemsControl ItemsSource="{Binding Keyboard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="{Binding Height}" Width="{Binding RollWidth}"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAccidental}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccidentalRowBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding TimeGridLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="1" Height="{Binding Height}" Opacity="0.6"
                                                   Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        <Setter Property="Panel.ZIndex" Value="1"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}" Cursor="Hand"
                                              MouseLeftButtonDown="Note_MouseLeftButtonDown"
                                              ToolTip="{Binding ToneName}">
                                            <Border CornerRadius="2" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRest}" Value="True">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Display}" FontSize="10" Margin="3,0,0,0"
                                                       VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRest}" Value="True">
                                                                <Setter Property="Foreground" Value="{x:Null}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Rectangle Width="5" HorizontalAlignment="Right" Fill="Transparent" Cursor="SizeWE"
                                                       MouseLeftButtonDown="NoteResize_MouseLeftButtonDown"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Polyline Points="{Binding PitchCurve}" StrokeThickness="1.5" Panel.ZIndex="2"
                                      Stroke="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                      Opacity="0.85"
                                      IsHitTestVisible="False"/>
                        </Canvas>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" IsEnabled="{Binding HasSelection}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <c:PropertiesEditor Grid.Row="0" Target="{Binding SelectedNote.Note}" IsScrollViewerEnabled="True"/>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{x:Static root:Texts.NoteGroupPortamento}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="26" Height="26" Command="{Binding AddPitchPointCommand}" ToolTip="{x:Static root:Texts.AddPitchPoint}"
                                    Content="{DynamicResource {x:Static icons:IconKeys.Plus}}"/>
                            <Button Width="26" Height="26" Command="{Binding RemovePitchPointCommand}" ToolTip="{x:Static root:Texts.RemovePitchPoint}"
                                    Content="{DynamicResource {x:Static icons:IconKeys.Minus}}"/>
                            <Button Width="26" Height="26" Command="{Binding ResetPitchCommand}" ToolTip="{x:Static root:Texts.ResetPitch}"
                                    Content="{DynamicResource {x:Static icons:IconKeys.Restore}}"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding PitchPoints}"
                              SelectedItem="{Binding SelectedPitchPoint}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              MinHeight="52"
                              MaxHeight="140"
                              CellEditEnding="PitchGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static root:Texts.PitchPointTime}" Width="*"
                                                Binding="{Binding Milliseconds, StringFormat=F0}"/>
                            <DataGridTextColumn Header="{x:Static root:Texts.PitchPointCents}" Width="*"
                                                Binding="{Binding Cents, StringFormat=F0}"/>
                            <DataGridComboBoxColumn Header="{x:Static root:Texts.PitchPointShape}" Width="*"
                                                    ItemsSource="{Binding Source={x:Static vm:NoteEditorViewModel.PitchShapes}}"
                                                    DisplayMemberPath="Name"
                                                    SelectedValuePath="Value"
                                                    SelectedValueBinding="{Binding Shape}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </c:PopupButton.PopupContent>
    </c:PopupButton>
</UserControl>
