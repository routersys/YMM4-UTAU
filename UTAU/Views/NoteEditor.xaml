<UserControl x:Class="UTAU.Views.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:UTAU"
             xmlns:vm="clr-namespace:UTAU.ViewModels"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:NoteEditorViewModel}}">
    <c:PopupButton x:Name="PopupHost"
                   Content="{x:Static root:Texts.EditNotes}"
                   PopupWidth="980"
                   PopupHeight="480"
                   ResizeMode="Both"
                   BeginEdit="PopupButton_BeginEdit"
                   EndEdit="PopupButton_EndEdit">
        <c:PopupButton.PopupContent>
            <ContentControl x:Name="SurfaceHost"/>
        </c:PopupButton.PopupContent>
    </c:PopupButton>
</UserControl>
