<UserControl x:Class="UTAU.Views.UTAUSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:UTAU"
             xmlns:vm="clr-namespace:UTAU.ViewModels"
             xmlns:syn="clr-namespace:UTAU.Synthesis"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:ps="clr-namespace:YukkuriMovieMaker.Settings;assembly=YukkuriMovieMaker.Plugin"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type={x:Type vm:UTAUSettingsViewModel}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Expander Header="{x:Static root:Texts.UTAU}" IsExpanded="True">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="26" Command="{Binding OpenDefaultDirectoryCommand}" ToolTip="{x:Static root:Texts.OpenDefaultDirectory}"
                                    Content="{DynamicResource {x:Static icons:IconKeys.FolderOpenOutline}}"/>
                            <Button Width="26" Command="{Binding RefreshCommand}" ToolTip="{x:Static root:Texts.Refresh}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.Refresh}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.LoadingAnimation}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Header="{x:Static root:Texts.SearchDirectories}" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding DefaultDirectory}" ToolTip="{Binding DefaultDirectory}"/>
                    <ListBox Grid.Row="1" MinHeight="60" MaxHeight="120"
                             ItemsSource="{Binding Settings.SearchDirectories}"
                             SelectedItem="{Binding SelectedDirectory}"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="26" Command="{Binding AddDirectoryCommand}" ToolTip="{x:Static root:Texts.AddDirectory}"
                                Content="{DynamicResource {x:Static icons:IconKeys.Plus}}"/>
                        <Button Width="26" Command="{Binding RemoveDirectoryCommand}" ToolTip="{x:Static root:Texts.RemoveDirectory}"
                                Content="{DynamicResource {x:Static icons:IconKeys.Minus}}"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <Expander Header="{x:Static root:Texts.VoiceBankList}" IsExpanded="True">
                <Grid Height="340">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" Margin="0"
                             ItemsSource="{Binding Banks}"
                             SelectedItem="{Binding SelectedBank}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="32" Height="32" Stretch="Uniform" Source="{Binding Image}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Author}" FontSize="10" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Column="1" Margin="0" DataContext="{Binding SelectedBank}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasWeb, Converter={StaticResource BooleanToVisibility}}">
                                <Hyperlink Command="{Binding Source={x:Static ps:CommandSettings.Default}, Path=[OpenUri]}" CommandParameter="{Binding Web}">
                                    <Run Text="{Binding Web, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                        <TabControl Grid.Row="1" Margin="0" Padding="0">
                            <TabItem Header="{x:Static root:Texts.InfoTabInformation}">
                                <DataGrid ItemsSource="{Binding Information}"
                                          Margin="0"
                                          BorderThickness="0"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static root:Texts.InfoKey}" Binding="{Binding Key}" Width="140"/>
                                        <DataGridTextColumn Header="{x:Static root:Texts.InfoValue}" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="{x:Static root:Texts.InfoTabPortrait}" IsEnabled="{Binding HasPortrait}">
                                <Image Source="{Binding Portrait}" Stretch="Uniform" StretchDirection="DownOnly"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </TabItem>
                            <TabItem Header="{x:Static root:Texts.InfoReadme}" IsEnabled="{Binding HasReadme}">
                                <TextBox Text="{Binding Readme, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         Margin="0" BorderThickness="0" Background="Transparent"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         AcceptsReturn="True"/>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Expander>

            <Expander Header="{x:Static root:Texts.EngineSettings}" IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static root:Texts.F0EstimatorLabel}" VerticalAlignment="Center"/>
                    <c:EnumComboBox Grid.Row="0" Grid.Column="1" EnumType="{x:Type syn:F0Estimator}"
                                    Value="{Binding Settings.F0Estimator}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static root:Texts.StretchModeLabel}" VerticalAlignment="Center"/>
                    <c:EnumComboBox Grid.Row="1" Grid.Column="1" EnumType="{x:Type syn:StretchMode}"
                                    Value="{Binding Settings.StretchMode}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static root:Texts.AnalysisCacheLabel}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <c:TextBoxSlider Width="160" Value="{Binding Settings.AnalysisCacheMegabytes}"
                                         StringFormat="F0" Unit="MB" DefaultValue="512"
                                         DefaultMin="64" DefaultMax="4096" Min="64" Max="4096" Delay="-1"/>
                        <Button Width="26" Command="{Binding ClearCacheCommand}" ToolTip="{x:Static root:Texts.ClearCache}"
                                Content="{DynamicResource {x:Static icons:IconKeys.Delete}}"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <GroupBox Header="{x:Static root:Texts.AboutUTAU}">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{x:Static root:Texts.AboutUTAUDescription}"/>
                    <LineBreak/>
                    <Run Text="{x:Static root:Texts.AboutUTAUHowTo}"/>
                    <LineBreak/>
                    <Run Text="{x:Static root:Texts.AboutUTAUNotation}"/>
                    <LineBreak/>
                    <Run Text="{x:Static root:Texts.AboutUTAUNotationExample}"/>
                    <LineBreak/>
                    <Run Text="{x:Static root:Texts.AboutUTAUCredit}"/>
                </TextBlock>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
