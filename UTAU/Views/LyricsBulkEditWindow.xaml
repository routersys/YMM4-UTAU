<Window x:Class="UTAU.Views.LyricsBulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:root="clr-namespace:UTAU"
        xmlns:v="clr-namespace:UTAU.Views"
        xmlns:vm="clr-namespace:UTAU.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type vm:LyricsBulkEditViewModel}}"
        Title="{x:Static root:Texts.EditLyrics}"
        Width="560" Height="320" MinWidth="360" MinHeight="220"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Style>
        <Style TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}"/>
    </Window.Style>
    <v:LyricsBulkEditView x:Name="View"/>
</Window>
